# Aiven PostgreSQL — the only database used by Roadmap
DATABASE_URL="postgres://avnadmin:YOUR_PASSWORD@roadmap-saver-jaibhagtani2.g.aivencloud.com:13523/defaultdb?sslmode=require"

# Server-only signing key. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Public application URL used for reset links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Redis cache (optional locally, required for shared caching in production)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=roadmap-tracker
REDIS_DEFAULT_TTL=30
# Client refresh/watchdog settings
NEXT_PUBLIC_APP_SYNC_MS=180000
NEXT_PUBLIC_INACTIVITY_TIMEOUT_MS=7200000
# Session warning shown before inactivity logout (default: 5 minutes)
NEXT_PUBLIC_INACTIVITY_WARNING_MS=300000

# Editor last-activity write interval. Only writes when editor activity occurred; minimum 60s.
NEXT_PUBLIC_EDITOR_ACTIVITY_SYNC_MS=60000

# Collaboration background refresh. Refreshes only when data changes; pauses while tab is hidden.
NEXT_PUBLIC_COLLAB_SYNC_MS=15000

# Nodemailer + Gmail SMTP (server-only; never expose these as NEXT_PUBLIC_ variables)
# Recommended for local/small projects: use a Gmail App Password with 2-Step Verification.
# Gmail SMTP sender account. SMTP_USER must be the Gmail address itself.
SMTP_USER="your.gmail@gmail.com"
# Use the Google App Password for SMTP_USER, NOT the normal Gmail password.
# Google may display it as "xxxx xxxx xxxx xxxx"; spaces are removed automatically.
SMTP_PASS="your-16-character-gmail-app-password"
# Optional SMTP connection settings. Defaults are Gmail's standard submission settings.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
# Optional: sender address/name. The authenticated Gmail account should normally be used.
SMTP_FROM="Roadmap <your.gmail@gmail.com>"
# OTP lifetime in seconds (default 600 = 10 minutes)
OTP_TTL_SECONDS=600

# Prisma serverless connection pool. Start conservatively; override only if your DB pooler supports more.
PRISMA_CONNECTION_LIMIT=1
# Redis auth-session cache TTL in seconds; reduces repeated session DB lookups.
AUTH_SESSION_CACHE_TTL=30
