model User {
  id           String               @id @default(uuid()) @db.Uuid
  email        String               @unique
  fullName     String               @map("full_name")
  passwordHash String               @map("password_hash")
  emailVerifiedAt DateTime?         @map("email_verified_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  topicProgress UserTopicProgress[]

  @@map("users")
}

model Session {
  id        String   @id @db.VarChar(64)
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @db.VarChar(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Roadmap {
  id            String         @id @default(uuid()) @db.Uuid
  ownerId       String         @map("owner_id") @db.VarChar(255)
  title         String
  description   String         @default("")
  privacy       Privacy        @default(private)
  shareSlug     String         @unique @default(cuid()) @map("share_slug")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  version       Int            @default(0)
  editorState   Json           @default("{}") @map("editor_state")
  topics        Topic[]
  goals         Goal[]
  shares        RoadmapShare[]
  shareRequests ShareRequest[]
  todos         Todo[]
  collaborationEvents CollaborationEvent[]
  messages      CollaborationMessage[]
  presence      CollaborationPresence[]
  communityGroup CollabGroup?
  branches      CollabBranch[]
  notifications Notification[]

  @@map("roadmaps")
}

model Topic {
  id            String         @id @default(uuid()) @db.Uuid
  roadmapId     String         @map("roadmap_id") @db.Uuid
  parentId      String?        @map("parent_id") @db.Uuid
  title         String
  description   String         @default("")
  notes         String         @default("")
  status        Status         @default(not_started)
  progress      Int            @default(0)
  priority      Int            @default(0)
  position      Int            @default(0)
  tags          String[]       @default([])
  dueDate       DateTime?      @map("due_date") @db.Date
  shareToken    String?        @unique @map("share_token")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  roadmap       Roadmap        @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  resources     Resource[]
  todos         Todo[]
  shareRequests ShareRequest[]
  topicShares   TopicShare[]
  personalProgress UserTopicProgress[]

  @@index([roadmapId, parentId, position])
  @@map("topics")
}


model UserTopicProgress {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  topicId   String   @map("topic_id") @db.Uuid
  status    String   @default("learning")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, updatedAt])
  @@index([topicId])
  @@map("user_topic_progress")
}

model Resource {
  id        String   @id @default(uuid()) @db.Uuid
  topicId   String   @map("topic_id") @db.Uuid
  title     String
  url       String
  type      String   @default("other")
  notes     String   @default("")
  completed Boolean  @default(false)
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@map("resources")
}

model Todo {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.VarChar(255)
  roadmapId String?  @map("roadmap_id") @db.Uuid
  topicId   String?  @map("topic_id") @db.Uuid
  todoDate  DateTime @map("todo_date") @db.Date
  title     String
  notes     String   @default("")
  completed Boolean  @default(false)
  priority  Int      @default(0)
  position  Int      @default(0)
  visibility String   @default("private") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  roadmap   Roadmap? @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  topic     Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([ownerId, todoDate, position])
  @@map("todos")
}

model DailyLog {
  id                 String   @id @default(uuid()) @db.Uuid
  ownerId            String   @map("owner_id") @db.VarChar(255)
  logDate            DateTime @map("log_date") @db.Date
  studyMinutes       Int      @default(0) @map("study_minutes")
  topicsStudied      String[] @default([]) @map("topics_studied")
  resourcesCompleted Int      @default(0) @map("resources_completed")
  problemsSolved     Int      @default(0) @map("problems_solved")
  learned            String   @default("")
  difficulties       String   @default("")
  tomorrowGoal       String   @default("") @map("tomorrow_goal")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([ownerId, logDate])
  @@map("daily_logs")
}

model Goal {
  id          String    @id @default(uuid()) @db.Uuid
  ownerId     String    @map("owner_id") @db.VarChar(255)
  roadmapId   String?   @map("roadmap_id") @db.Uuid
  title       String
  description String    @default("")
  deadline    DateTime? @db.Date
  progress    Int       @default(0)
  status      Status    @default(in_progress)
  createdAt   DateTime  @default(now()) @map("created_at")
  roadmap     Roadmap?  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([ownerId, deadline])
  @@map("goals")
}

model Template {
  id            String          @id @default(uuid()) @db.Uuid
  name          String          @unique
  description   String          @default("")
  tree          Json
  createdAt     DateTime        @default(now()) @map("created_at")
  shareRequests ShareRequest[]
  shares        TemplateShare[]

  @@map("templates")
}

model Profile {
  id        String   @id @map("id") @db.VarChar(255)
  fullName  String   @default("") @map("full_name")
  avatarUrl String   @default("") @map("avatar_url")
  bio       String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("profiles")
}

enum Status {
  not_started
  in_progress
  completed
}

enum Privacy {
  private
  link
  public
}

model RoadmapShare {
  id        String   @id @default(uuid()) @db.Uuid
  roadmapId String   @map("roadmap_id") @db.Uuid
  userId    String   @map("user_id") @db.VarChar(255)
  role      String   @default("contributor")
  createdAt DateTime @default(now()) @map("created_at")
  roadmap   Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, userId])
  @@index([userId])
  @@map("roadmap_shares")
}

model ShareRequest {
  id            String         @id @default(uuid()) @db.Uuid
  roadmapId     String?        @map("roadmap_id") @db.Uuid
  rootTopicId   String?        @map("root_topic_id") @db.Uuid
  templateId    String?        @map("template_id") @db.Uuid
  scopeType     String         @default("roadmap") @map("scope_type")
  requestType   String         @default("share") @map("request_type")
  senderId      String         @map("sender_id") @db.VarChar(255)
  receiverId    String         @map("receiver_id") @db.VarChar(255)
  message       String         @default("")
  role          String         @default("contributor")
  status        String         @default("pending")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  roadmap       Roadmap?       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  rootTopic     Topic?         @relation(fields: [rootTopicId], references: [id], onDelete: Cascade)
  template      Template?      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([receiverId, status, createdAt])
  @@index([senderId, createdAt])
  @@index([roadmapId, rootTopicId, receiverId, status])
  @@map("share_requests")
}

model TopicShare {
  id        String   @id @default(uuid()) @db.Uuid
  topicId   String   @map("topic_id") @db.Uuid
  userId    String   @map("user_id") @db.VarChar(255)
  role      String   @default("contributor")
  createdAt DateTime @default(now()) @map("created_at")
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId])
  @@index([userId])
  @@map("topic_shares")
}

model TemplateShare {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  userId     String   @map("user_id") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId])
  @@index([userId])
  @@map("template_shares")
}

model Notification {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.VarChar(255)
  type           String
  title          String
  body           String        @default("")
  roadmapId      String?       @map("roadmap_id") @db.Uuid
  roadmap        Roadmap?      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  shareRequestId String?       @map("share_request_id") @db.Uuid
  readAt         DateTime?     @map("read_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  shareRequest   ShareRequest? @relation(fields: [shareRequestId], references: [id], onDelete: Cascade)
  collabGroupJoinRequestId String? @map("collab_group_join_request_id") @db.Uuid
  collabGroupJoinRequest CollabGroupJoinRequest? @relation(fields: [collabGroupJoinRequestId], references: [id], onDelete: Cascade)
  collabCommitId String? @map("collab_commit_id") @db.Uuid
  collabCommit CollabCommit? @relation(fields: [collabCommitId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}


model CollabBranch {
  id            String   @id @default(uuid()) @db.Uuid
  roadmapId     String   @map("roadmap_id") @db.Uuid
  ownerId       String   @map("owner_id") @db.VarChar(255)
  name          String
  rootTopicId   String?  @map("root_topic_id") @db.Uuid
  baseVersion   Int      @map("base_version")
  version       Int      @default(0)
  status        String   @default("open")
  snapshot      Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  roadmap       Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  commits       CollabCommit[]
  @@unique([roadmapId, ownerId, name])
  @@index([roadmapId, status, updatedAt])
  @@index([ownerId, status, updatedAt])
  @@map("collab_branches")
}

model CollabCommit {
  id         String   @id @default(uuid()) @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  authorId   String   @map("author_id") @db.VarChar(255)
  message    String
  baseVersion Int     @map("base_version")
  snapshot   Json
  status     String   @default("pending")
  createdAt  DateTime @default(now()) @map("created_at")
  mergedAt   DateTime? @map("merged_at")
  mergedBy   String?  @map("merged_by") @db.VarChar(255)
  branch     CollabBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@index([branchId, createdAt])
  @@index([status, createdAt])
  notifications Notification[]
  @@map("collab_commits")
}

model CollaborationEvent {
  id        String   @id @default(uuid()) @db.Uuid
  roadmapId String   @map("roadmap_id") @db.Uuid
  actorId   String   @map("actor_id") @db.VarChar(255)
  version   Int
  operation String
  entityType String  @map("entity_type")
  entityId  String?  @map("entity_id") @db.Uuid
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  roadmap   Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, version])
  @@index([roadmapId, createdAt])
  @@map("collaboration_events")
}

model CollaborationMessage {
  id        String   @id @default(uuid()) @db.Uuid
  roadmapId String   @map("roadmap_id") @db.Uuid
  authorId  String   @map("author_id") @db.VarChar(255)
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  roadmap   Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId, createdAt])
  @@map("collaboration_messages")
}

model CollaborationPresence {
  roadmapId String   @map("roadmap_id") @db.Uuid
  userId    String   @map("user_id") @db.VarChar(255)
  lastSeen  DateTime @default(now()) @map("last_seen")
  roadmap   Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@id([roadmapId, userId])
  @@index([roadmapId, lastSeen])
  @@map("collaboration_presence")
}

model CollabGroup {
  id           String                 @id @default(uuid()) @db.Uuid
  roadmapId    String                 @unique @map("roadmap_id") @db.Uuid
  ownerId      String                 @map("owner_id") @db.VarChar(255)
  name         String
  description  String                 @default("")
  maxMembers   Int                    @default(10) @map("max_members")
  discoverable Boolean                @default(true)
  settings     Json                   @default("{}") @map("settings")
  inviteToken  String                 @unique @default(cuid()) @map("invite_token")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  roadmap      Roadmap                @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  members      CollabGroupMember[]
  joinRequests CollabGroupJoinRequest[]

  @@index([discoverable, createdAt])
  @@index([ownerId])
  @@map("collab_groups")
}

model CollabGroupMember {
  id        String      @id @default(uuid()) @db.Uuid
  groupId   String      @map("group_id") @db.Uuid
  userId    String      @map("user_id") @db.VarChar(255)
  role      String      @default("member")
  createdAt DateTime    @default(now()) @map("created_at")
  group     CollabGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("collab_group_members")
}

model CollabGroupJoinRequest {
  id         String      @id @default(uuid()) @db.Uuid
  groupId    String      @map("group_id") @db.Uuid
  requesterId String     @map("requester_id") @db.VarChar(255)
  message    String      @default("")
  status     String      @default("pending")
  reviewedBy String?     @map("reviewed_by") @db.VarChar(255)
  reviewedAt DateTime?   @map("reviewed_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  group      CollabGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([groupId, status, createdAt])
  @@index([requesterId, status, createdAt])
  @@map("collab_group_join_requests")
}
